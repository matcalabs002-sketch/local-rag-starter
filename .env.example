# Copy to .env or run: python -m rag setup
# setup generates a random local password and matching URL, without contacting services.
POSTGRES_PASSWORD=
POSTGRES_PORT=55432
DATABASE_URL=
# Required only for remote Supabase (Session pooler port 5432; verified TLS).
SUPABASE_PROJECT_URL=
DATABASE_CA_FILE=

# Ollama: explicit local default. Change to :11434 to use an existing standard server.
OLLAMA_URL=http://127.0.0.1:11435
CHAT_PROVIDER=ollama
CHAT_MODEL=qwen3:4b
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text:v1.5
EMBEDDING_DIMENSIONS=768
OLLAMA_KEEP_ALIVE=10m
MAX_CONTEXT_CHARS=12000
MAX_ANSWER_TOKENS=900
TOP_K=5
# Changing embeddings or chunking requires Settings > Rebuild index.
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
# Private originals; relative paths are resolved from the repository root.
RAG_DATA_DIR=.private
MAX_FILE_BYTES=52428800
SYNC_SECONDS=300

# Optional Google Drive integration: pip install -e '.[drive]'
DRIVE_FOLDER_ID=
# Optional paid adapters: no automatic paid fallback. Never commit keys.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
